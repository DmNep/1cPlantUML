
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ВерсияОбработки = КомментарийМетаданныхОбработки();
	
	СерверРендеринга = "www.plantuml.com";
	РесурсСервера = "/plantuml/png/";
	ТаймаутСоединения = 20000;
	
	УстановитьВидимостьЭлементов();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПолныйИнтерфейсПриИзменении(Элемент)
	
	УстановитьВидимостьЭлементов();
	
	Если Не ЗначениеЗаполнено(Объект.Базы) Или Не ЗначениеЗаполнено(Объект.Обмены) Тогда
		Возврат;
	КонецЕсли;
	
	СформироватьСхемуНаКлиенте();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыБазы

&НаКлиенте
Процедура БазыПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	СоздатьСпискиВыбора();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СформироватьСхему(Команда)
	
	Если Не ДанныеСхемыЗаполнены() Тогда
		Возврат;
	КонецЕсли;
	
	СформироватьСхемуНаКлиенте();
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьНастройки(Команда)
	
	Если Не ДанныеСхемыЗаполнены() Тогда
		Возврат;
	КонецЕсли;
	
	ПутьКФайлу = ПолучитьПутьКФайлу(РежимДиалогаВыбораФайла.Сохранение, "XML (*.xml)|*.xml", "Сохранить настройки");
	Если ПутьКФайлу = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаписьВ_XML(ПутьКФайлу);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьНастройки(Команда)
	
	НачатьЗагрузкуФайла("XML");
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьСхемуPlantuml(Команда)
	
	Если Не ЗначениеЗаполнено(Схема) Тогда
		СообщитьПользователюТекст("Сформируйте схему PlantUML.");
		Возврат;
	КонецЕсли;
	
	ПутьКФайлу = ПолучитьПутьКФайлу(РежимДиалогаВыбораФайла.Сохранение, "PlantUML (*.puml)|*.puml", "Сохранить схему PlantUML");
	Если ПутьКФайлу = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаписьВ_PlantUML(ПутьКФайлу);
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьГрафическуюСхему(Команда)
	
	Если Не ЗначениеЗаполнено(РезультатОбработки) Тогда
		СообщитьПользователюТекст("Сформируйте схему.");
		Возврат;
	КонецЕсли;
	
	ПутьКФайлу = ПолучитьПутьКФайлу(РежимДиалогаВыбораФайла.Сохранение, "png (*.png)|*.png", "Сохранить картинку");
	Если ПутьКФайлу = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаписьВ_Картинку(ПутьКФайлу);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзТабДок(Команда)
	
	НачатьЗагрузкуФайла("MXL");
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область РаботаСФормой

&НаСервере
Функция КомментарийМетаданныхОбработки()
	
	Возврат РеквизитФормыВЗначение("Объект").Метаданные().Комментарий;
	
КонецФункции

Процедура УстановитьВидимостьЭлементов()
	
	ВидимостьПолногоИнтерфейса = ПолныйИнтерфейс;
	
	Элементы.БазыКомментСЛева.Видимость = ВидимостьПолногоИнтерфейса;
	Элементы.БазыИконка.Видимость = ВидимостьПолногоИнтерфейса;
	Элементы.ГруппаСхема.Видимость = ВидимостьПолногоИнтерфейса;
	Элементы.ЗагрузитьИзТабДок.Видимость = ВидимостьПолногоИнтерфейса;
	Элементы.ОбменыТипЛинии.Видимость = ВидимостьПолногоИнтерфейса;
	Элементы.ОбменыТолщинаЛинии.Видимость = ВидимостьПолногоИнтерфейса;
	Элементы.ОбменыЦветЛинии.Видимость = ВидимостьПолногоИнтерфейса;
	Элементы.ОбменыДвусторонний.Видимость = ВидимостьПолногоИнтерфейса;
	Элементы.Настройки.Видимость = ВидимостьПолногоИнтерфейса;
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьСпискиВыбора()
	
	СписокВыбора = Новый Массив;
	Для Каждого СтрокаБазы Из Объект.Базы Цикл
		Если Не ЗначениеЗаполнено(СтрокаБазы.База) Тогда
			Продолжить;
		КонецЕсли;
		СписокВыбора.Добавить(СтрокаБазы.База);
	КонецЦикла;
	
	Элементы.ОбменыБазаИсточник.СписокВыбора.ЗагрузитьЗначения(СписокВыбора);
	Элементы.ОбменыБазаПриемник.СписокВыбора.ЗагрузитьЗначения(СписокВыбора);
	
КонецПроцедуры

&НаКлиенте
Функция ДанныеСхемыЗаполнены()
	
	Если Не ЗначениеЗаполнено(Объект.Базы) Тогда
		СообщитьПользователюТекст("Заполните табличную часть Базы.");
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.Обмены) Тогда
		СообщитьПользователюТекст("Заполните табличную часть Обмены.");
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура СообщитьПользователюТекст(ТекстСообщения)
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстСообщения;
	Сообщение.Сообщить();
	
КонецПроцедуры

&НаСервере
Функция ДатаСеансаНаСервере()
	
	Возврат ТекущаяДатаСеанса();
	
КонецФункции

#КонецОбласти

#Область ФормированиеСхемы

&НаКлиенте
Процедура СформироватьСхемуНаКлиенте()
	
	ОчиститьПустыеСтрокиВТЧ();
	СформироватьСхемуНаСервере();
	
КонецПроцедуры

Процедура ОчиститьПустыеСтрокиВТЧ()
	
	ПустыеСтрокиБазы = Объект.Базы.НайтиСтроки(Новый Структура("База", ""));
	Для Каждого СтрокаБазы Из ПустыеСтрокиБазы Цикл
		Объект.Базы.Удалить(СтрокаБазы);
	КонецЦикла;
	
	ПустыеСтрокиОбмены = Объект.Обмены.НайтиСтроки(Новый Структура("Наименование, Разделитель", "", Ложь));
	Для Каждого СтрокаОбмены Из ПустыеСтрокиОбмены Цикл
		Объект.Обмены.Удалить(СтрокаОбмены);
	КонецЦикла;
	
КонецПроцедуры

Процедура СформироватьСхемуНаСервере()
	
	СхемаPlantUML = СоздатьСхемуPlantUML();
	СгенерироватьНаСервере(СхемаPlantUML);
	
КонецПроцедуры

Функция СоздатьСхемуPlantUML()
	
	Индекс = 0;
	
	КвалификаторыИмени = Новый КвалификаторыСтроки(0);
	ТипыСтроки = Новый Массив;
	ТипыСтроки.Добавить(Тип("Строка"));
	ОписаниеТипаСтрока = Новый ОписаниеТипов(ТипыСтроки, , КвалификаторыИмени);
	
	ТаблицаОбозначений = Новый ТаблицаЗначений;
	ТаблицаОбозначений.Колонки.Добавить("Наименование", ОписаниеТипаСтрока);
	ТаблицаОбозначений.Колонки.Добавить("Обозначение", ОписаниеТипаСтрока);
	
	Схема = "@startuml" + Символы.ПС + Символы.ПС;
	
	Схема = Схема + "'Создано обработкой 1c_ObmSchem, " + ТекущаяДатаСеанса() + Символы.ПС;
	Схема = Схема + "'Created by processing 1c_ObmSchem, " + ТекущаяДатаСеанса() + Символы.ПС;
	Схема = Схема + "'" + ВерсияОбработки + Символы.ПС;
	Схема = Схема + "'GitHub: github.com/DmNep/1cObmSchem" + Символы.ПС;
	Схема = Схема + Символы.ПС;
	
	Если ЗначениеЗаполнено(ЗаголовокСхемы) Тогда
		ТекстЗаголовка = ЭкранироватьТекстPlantUML(ЗаголовокСхемы);
	Иначе
		ТекстЗаголовка = "Схема обменов";
	КонецЕсли;
	Схема = Схема + "title " + ТекстЗаголовка + Символы.ПС + Символы.ПС;
	
	Для Каждого СтрокаБазы Из Объект.Базы Цикл
		
		ИконкаБазы = ИконкаPlantUMLПоЗначению(СтрокаБазы.Иконка);
		ИмяБазы = ЭкранироватьТекстPlantUML(СтрокаБазы.База);
		Схема = Схема + ИконкаБазы + " """ + ИмяБазы + """ as db" + Индекс + Символы.ПС;
		
		НовоеОбозначение = ТаблицаОбозначений.Добавить();
		НовоеОбозначение.Наименование = СтрокаБазы.База;
		НовоеОбозначение.Обозначение = "db" + Индекс;
		
		Если ЗначениеЗаполнено(СтрокаБазы.Комментарий) Тогда
			Если СтрокаБазы.КомментСЛева Тогда
				ОбозначениеКомментария = "hnote left of db";
			Иначе
				ОбозначениеКомментария = "hnote right of db";
			КонецЕсли;
			Схема = Схема + ОбозначениеКомментария + Индекс + Символы.ПС
				+ ТекстЗаметкиPlantUML(СтрокаБазы.Комментарий) + "end note" + Символы.ПС;
		КонецЕсли;
		
		Индекс = Индекс + 1;
		
	КонецЦикла;
	Схема = Схема + Символы.ПС;
	
	Для Каждого СтрокаОбмены Из Объект.Обмены Цикл
		
		Если ЗначениеЗаполнено(СтрокаОбмены.Наименование)
			И Не ЗначениеЗаполнено(СтрокаОбмены.БазаИсточник)
			И Не ЗначениеЗаполнено(СтрокаОбмены.БазаПриемник) Тогда
			Схема = Схема + "== " + ЭкранироватьТекстPlantUML(СтрокаОбмены.Наименование) + " ==" + Символы.ПС;
			Продолжить;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаОбмены.БазаИсточник) И Не ЗначениеЗаполнено(СтрокаОбмены.БазаПриемник) Тогда
			Продолжить;
		КонецЕсли;
		
		ОтборИсточника = Новый Структура("Наименование", СтрокаОбмены.БазаИсточник);
		НайденныйИсточник = ТаблицаОбозначений.НайтиСтроки(ОтборИсточника);
		ОтборПриемника = Новый Структура("Наименование", СтрокаОбмены.БазаПриемник);
		НайденныйПриемник = ТаблицаОбозначений.НайтиСтроки(ОтборПриемника);
		
		Если НайденныйИсточник.Количество() > 0 Тогда
			ОбозначениеИсточника = НайденныйИсточник[0].Обозначение;
		Иначе
			ОбозначениеИсточника = "";
		КонецЕсли;
		
		Если НайденныйПриемник.Количество() > 0 Тогда
			ОбозначениеПриемника = НайденныйПриемник[0].Обозначение;
		Иначе
			ОбозначениеПриемника = "";
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ОбозначениеИсточника) Или Не ЗначениеЗаполнено(ОбозначениеПриемника) Тогда
			СообщитьПользователюТекст(СтрШаблон(
				"Пропущена строка обмена ""%1"": не указаны база-источник и база-приемник.",
				СтрокаОбмены.Наименование));
			Продолжить;
		КонецЕсли;
		
		Схема = Схема + "skinparam ArrowThickness "
			+ ?(ЗначениеЗаполнено(СтрокаОбмены.ТолщинаЛинии), СтрокаОбмены.ТолщинаЛинии, 1) + Символы.ПС;
		
		Схема = Схема + ОбозначениеИсточника + ?(СтрокаОбмены.Двусторонний, "<", "")
			+ ?(СтрокаОбмены.ТипЛинии = "Пунктирная", "-", "")
			+ "-" + ?(ЗначениеЗаполнено(СтрокаОбмены.ЦветЛинии), "[#" + СтрокаОбмены.ЦветЛинии + "]", "") + ">"
			+ ОбозначениеПриемника + " : " + ЭкранироватьТекстPlantUML(СтрокаОбмены.Наименование) + Символы.ПС;
		
		Если ЗначениеЗаполнено(СтрокаОбмены.Комментарий) Тогда
			Схема = Схема + "note left " + Символы.ПС
				+ ТекстЗаметкиPlantUML(СтрокаОбмены.Комментарий) + "end note" + Символы.ПС;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаОбмены.КомментарийПравый) Тогда
			Схема = Схема + "note right " + Символы.ПС
				+ ТекстЗаметкиPlantUML(СтрокаОбмены.КомментарийПравый) + "end note" + Символы.ПС;
		КонецЕсли;
		
	КонецЦикла;
	
	Схема = Схема + Символы.ПС;
	Схема = Схема + "footer 1c_ObmSchem" + Символы.ПС + Символы.ПС;
	Схема = Схема + "@enduml";
	
	Возврат Схема;
	
КонецФункции

Функция ИконкаPlantUMLПоЗначению(ИконкаБазы)
	
	Если ИконкаБазы = "Человек" Тогда
		Возврат "actor";
	ИначеЕсли ИконкаБазы = "Коллекция" Тогда
		Возврат "collections";
	Иначе
		Возврат "database";
	КонецЕсли;
	
КонецФункции

Функция ТекстЗаметкиPlantUML(ТекстКомментария)
	
	СтрокиЗаметки = СтрРазделить(ТекстКомментария, "|");
	Возврат ЭкранироватьТекстPlantUML(СтрСоединить(СтрокиЗаметки, Символы.ПС)) + Символы.ПС;
	
КонецФункции

Функция ЭкранироватьТекстPlantUML(ИсходныйТекст)
	
	Результат = Строка(ИсходныйТекст);
	Результат = СтрЗаменить(Результат, "\", "\\");
	Результат = СтрЗаменить(Результат, """", "\""");
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область РаботаСФайлами

&НаКлиенте
Функция ПолучитьПутьКФайлу(Режим, Фильтр, ЗаголовокДиалога)
	
	Диалог = Новый ДиалогВыбораФайла(Режим);
	Диалог.Заголовок = ЗаголовокДиалога;
	Диалог.Фильтр = Фильтр;
	Диалог.МножественныйВыбор = Ложь;
	Если Диалог.Выбрать() Тогда
		Возврат Диалог.ПолноеИмяФайла;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

&НаКлиенте
Процедура НачатьЗагрузкуФайла(ФорматФайла)
	
	Если Объект.Базы.Количество() > 0 Или Объект.Обмены.Количество() > 0 Тогда
		Оповещение = Новый ОписаниеОповещения("ПослеВопросаОчисткиПередЗагрузкой", ЭтотОбъект, ФорматФайла);
		ПоказатьВопрос(Оповещение, НСтр("ru = 'Форма перед загрузкой будет очищена. Продолжить?'"), РежимДиалогаВопрос.ДаНет);
		Возврат;
	КонецЕсли;
	
	ВыполнитьЗагрузкуФайла(ФорматФайла);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОчисткиПередЗагрузкой(РезультатВопроса, ФорматФайла) Экспорт
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ВыполнитьЗагрузкуФайла(ФорматФайла);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьЗагрузкуФайла(ФорматФайла)
	
	Объект.Базы.Очистить();
	Объект.Обмены.Очистить();
	
	Если ФорматФайла = "XML" Тогда
		Если Не Чтение_XML() Тогда
			Возврат;
		КонецЕсли;
	Иначе
		Если Не Чтение_ТабДок() Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	СформироватьСхемуНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписьВ_XML(ПутьКФайлу)
	
	ДатаСеанса = ДатаСеансаНаСервере();
	ТекстКомментария = "";
	ТекстКомментария = ТекстКомментария + "'Создано обработкой 1c_ObmSchem, " + ДатаСеанса + Символы.ПС;
	ТекстКомментария = ТекстКомментария + "'Created by processing 1c_ObmSchem, " + ДатаСеанса + Символы.ПС;
	ТекстКомментария = ТекстКомментария + "'" + ВерсияОбработки + Символы.ПС;
	ТекстКомментария = ТекстКомментария + "'GitHub: github.com/DmNep/1cObmSchem" + Символы.ПС;
	
	ЗаписьXML = Новый ЗаписьXML;
	Попытка
		ЗаписьXML.ОткрытьФайл(ПутьКФайлу, "UTF-8");
		ЗаписьXML.ЗаписатьОбъявлениеXML();
		ЗаписьXML.ЗаписатьКомментарий(ТекстКомментария);
		
		ЗаписьXML.ЗаписатьНачалоЭлемента("СхемаОбменов");
		ЗаписьXML.ЗаписатьАтрибут("ЗаголовокСхемы", Строка(ЗаголовокСхемы));
		
		Для Каждого СтрокаБазы Из Объект.Базы Цикл
			ЗаписьXML.ЗаписатьНачалоЭлемента("Базы");
			ЗаписьXML.ЗаписатьАтрибут("База", Строка(СтрокаБазы.База));
			ЗаписьXML.ЗаписатьАтрибут("Комментарий", Строка(СтрокаБазы.Комментарий));
			ЗаписьXML.ЗаписатьАтрибут("КомментСЛева", Строка(СтрокаБазы.КомментСЛева));
			ЗаписьXML.ЗаписатьАтрибут("Иконка", Строка(СтрокаБазы.Иконка));
			ЗаписьXML.ЗаписатьКонецЭлемента();
		КонецЦикла;
		
		Для Каждого СтрокаОбмены Из Объект.Обмены Цикл
			ЗаписьXML.ЗаписатьНачалоЭлемента("Обмены");
			ЗаписьXML.ЗаписатьАтрибут("БазаИсточник", Строка(СтрокаОбмены.БазаИсточник));
			ЗаписьXML.ЗаписатьАтрибут("Наименование", Строка(СтрокаОбмены.Наименование));
			ЗаписьXML.ЗаписатьАтрибут("БазаПриемник", Строка(СтрокаОбмены.БазаПриемник));
			ЗаписьXML.ЗаписатьАтрибут("Комментарий", Строка(СтрокаОбмены.Комментарий));
			ЗаписьXML.ЗаписатьАтрибут("КомментарийПравый", Строка(СтрокаОбмены.КомментарийПравый));
			ЗаписьXML.ЗаписатьАтрибут("Двусторонний", Строка(СтрокаОбмены.Двусторонний));
			ЗаписьXML.ЗаписатьАтрибут("ТолщинаЛинии", Строка(СтрокаОбмены.ТолщинаЛинии));
			ЗаписьXML.ЗаписатьАтрибут("ЦветЛинии", Строка(СтрокаОбмены.ЦветЛинии));
			ЗаписьXML.ЗаписатьАтрибут("ТипЛинии", Строка(СтрокаОбмены.ТипЛинии));
			ЗаписьXML.ЗаписатьКонецЭлемента();
		КонецЦикла;
		
		ЗаписьXML.ЗаписатьКонецЭлемента();
		ЗаписьXML.Закрыть();
	Исключение
		Попытка
			ЗаписьXML.Закрыть();
		Исключение
		КонецПопытки;
		ВызватьИсключение;
	КонецПопытки;
	
	ПоказатьОповещениеПользователя("Уведомление", , "Файл выгружен!", БиблиотекаКартинок.Успешно32);
	
КонецПроцедуры

&НаКлиенте
Функция Чтение_XML()
	
	ПутьКФайлу = ПолучитьПутьКФайлу(РежимДиалогаВыбораФайла.Открытие, "XML (*.xml)|*.xml", "Выбрать файл настроек");
	Если ПутьКФайлу = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ОписаниеТипаБулево = Новый ОписаниеТипов("Булево");
	ОписаниеТипаЧисло = Новый ОписаниеТипов("Число");
	
	ЧтениеXML = Новый ЧтениеXML;
	Попытка
		ЧтениеXML.ОткрытьФайл(ПутьКФайлу);
		
		Пока ЧтениеXML.Прочитать() Цикл
			Если ЧтениеXML.ТипУзла <> ТипУзлаXML.НачалоЭлемента Тогда
				Продолжить;
			КонецЕсли;
			
			Если ЧтениеXML.Имя = "СхемаОбменов" Тогда
				ЗаголовокСхемы = ЧтениеXML.ЗначениеАтрибута("ЗаголовокСхемы");
			КонецЕсли;
			
			Если ЧтениеXML.Имя = "Базы" Тогда
				НоваяСтрока = Объект.Базы.Добавить();
				НоваяСтрока.База = ЧтениеXML.ЗначениеАтрибута("База");
				НоваяСтрока.Комментарий = ЧтениеXML.ЗначениеАтрибута("Комментарий");
				НоваяСтрока.КомментСЛева = ОписаниеТипаБулево.ПривестиЗначение(ЧтениеXML.ЗначениеАтрибута("КомментСЛева"));
				НоваяСтрока.Иконка = ЧтениеXML.ЗначениеАтрибута("Иконка");
			КонецЕсли;
			
			Если ЧтениеXML.Имя = "Обмены" Тогда
				НоваяСтрока = Объект.Обмены.Добавить();
				НоваяСтрока.БазаИсточник = ЧтениеXML.ЗначениеАтрибута("БазаИсточник");
				НоваяСтрока.Наименование = ЧтениеXML.ЗначениеАтрибута("Наименование");
				НоваяСтрока.БазаПриемник = ЧтениеXML.ЗначениеАтрибута("БазаПриемник");
				НоваяСтрока.Двусторонний = ОписаниеТипаБулево.ПривестиЗначение(ЧтениеXML.ЗначениеАтрибута("Двусторонний"));
				НоваяСтрока.Комментарий = ЧтениеXML.ЗначениеАтрибута("Комментарий");
				НоваяСтрока.КомментарийПравый = ЧтениеXML.ЗначениеАтрибута("КомментарийПравый");
				НоваяСтрока.ТолщинаЛинии = ОписаниеТипаЧисло.ПривестиЗначение(ЧтениеXML.ЗначениеАтрибута("ТолщинаЛинии"));
				НоваяСтрока.ЦветЛинии = ЧтениеXML.ЗначениеАтрибута("ЦветЛинии");
				НоваяСтрока.ТипЛинии = ЧтениеXML.ЗначениеАтрибута("ТипЛинии");
			КонецЕсли;
		КонецЦикла;
		
		ЧтениеXML.Закрыть();
	Исключение
		Попытка
			ЧтениеXML.Закрыть();
		Исключение
		КонецПопытки;
		ВызватьИсключение;
	КонецПопытки;
	
	СоздатьСпискиВыбора();
	ПоказатьОповещениеПользователя("Уведомление", , "Файл загружен!", БиблиотекаКартинок.Успешно32);
	
	Возврат Истина;
	
КонецФункции

