&НаКлиенте
Функция Чтение_ТабДок()
	
	ПутьКФайлу = ПолучитьПутьКФайлу(РежимДиалогаВыбораФайла.Открытие, "MXL (*.mxl)|*.mxl", "Выбрать табличный документ");
	Если ПутьКФайлу = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ДанныеФайла = Новый ДвоичныеДанные(ПутьКФайлу);
	АдресФайла = ПоместитьВоВременноеХранилище(ДанныеФайла, УникальныйИдентификатор);
	ПрочитатьMXL_в_ТабДок(АдресФайла);
	
	СоздатьСпискиВыбора();
	ПоказатьОповещениеПользователя("Уведомление", , "Файл загружен!", БиблиотекаКартинок.Успешно32);
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Процедура ПрочитатьMXL_в_ТабДок(АдресФайла)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ДанныеФайла = ПолучитьИзВременногоХранилища(АдресФайла);
	ТабличныйДокумент.Прочитать(ДанныеФайла.ОткрытьПотокДляЧтения(), СпособЧтенияЗначенийТабличногоДокумента.Текст, ТипФайлаТабличногоДокумента.MXL);
	
	Построитель = Новый ПостроительЗапроса;
	Построитель.ИсточникДанных = Новый ОписаниеИсточникаДанных(ТабличныйДокумент.Область());
	Построитель.ДобавлениеПредставлений = ТипДобавленияПредставлений.НеДобавлять;
	Построитель.ЗаполнитьНастройки();
	Построитель.Выполнить();
	ТаблицаИзМакета = Построитель.Результат.Выгрузить();
	
	УникальныеБазы = Новый Соответствие;
	Для Каждого СтрокаТаблицы Из ТаблицаИзМакета Цикл
		
		Если ЗначениеЗаполнено(СтрокаТаблицы.Источник) И УникальныеБазы.Получить(СтрокаТаблицы.Источник) = Неопределено Тогда
			УникальныеБазы.Вставить(СтрокаТаблицы.Источник, Истина);
			НоваяБаза = Объект.Базы.Добавить();
			НоваяБаза.База = СтрокаТаблицы.Источник;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаТаблицы.Приемник) И УникальныеБазы.Получить(СтрокаТаблицы.Приемник) = Неопределено Тогда
			УникальныеБазы.Вставить(СтрокаТаблицы.Приемник, Истина);
			НоваяБаза = Объект.Базы.Добавить();
			НоваяБаза.База = СтрокаТаблицы.Приемник;
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого СтрокаТаблицы Из ТаблицаИзМакета Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.Наименование)
			Или Не ЗначениеЗаполнено(СтрокаТаблицы.Источник)
			Или Не ЗначениеЗаполнено(СтрокаТаблицы.Приемник) Тогда
			Продолжить;
		КонецЕсли;
		
		НовыйОбмен = Объект.Обмены.Добавить();
		НовыйОбмен.БазаИсточник = СтрокаТаблицы.Источник;
		НовыйОбмен.Наименование = СтрокаТаблицы.Наименование;
		НовыйОбмен.БазаПриемник = СтрокаТаблицы.Приемник;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область РендерингPlantUML

&НаСервере
Процедура СгенерироватьНаСервере(СхемаPlantUML)
	
	Результат = СгенерированноеИзображение(СхемаPlantUML, СерверРендеринга, РесурсСервера, ТаймаутСоединения);
	Если ЗначениеЗаполнено(Результат.АдресИзображения) Тогда
		РезультатОбработки = Результат.АдресИзображения;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция СгенерированноеИзображение(Данные, АдресСервера, ПутьРесурса, Таймаут)
	
	Результат = Новый Структура;
	Результат.Вставить("ОтветСервера", Неопределено);
	Результат.Вставить("АдресИзображения", "");
	
	ДвоичныеДанныеСтроки = ПолучитьДвоичныеДанныеИзСтроки(Данные);
	СжатыеДанные = СжатыеДанные(ДвоичныеДанныеСтроки);
	СтрокаBase64 = Base64Строка(СжатыеДанные);
	ФорматPlantUML = ФорматPlantUML(СтрокаBase64);
	
	ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL(Неопределено, Неопределено);
	Соединение = Новый HTTPСоединение(АдресСервера, 443, Неопределено, Неопределено, Неопределено, Таймаут, ЗащищенноеСоединение);
	Запрос = Новый HTTPЗапрос(ПутьРесурса + ФорматPlantUML);
	Ответ = Соединение.Получить(Запрос);
	
	Если Ответ.КодСостояния <> 200 Тогда
		СообщитьПользователюТекст(СтрШаблон("Не удалось получить схему PlantUML. Код ответа: %1", Ответ.КодСостояния));
		Возврат Результат;
	КонецЕсли;
	
	ДвоичныеДанныеКартинки = Ответ.ПолучитьТелоКакДвоичныеДанные();
	Результат.Вставить("ОтветСервера", Ответ);
	Результат.Вставить("АдресИзображения", ПоместитьВоВременноеХранилище(ДвоичныеДанныеКартинки));
	
	Возврат Результат;
	
КонецФункции

Функция СжатыеДанные(Данные)
	
	ЧтениеДанных = Новый ЧтениеДанных(ЗаписатьZip(Данные));
	
	НачальноеСмещение = 14;
	ЧтениеДанных.Пропустить(НачальноеСмещение);
	CRC32 = ЧтениеДанных.ПрочитатьЦелое32();
	
	РазмерСжатыхДанных = ЧтениеДанных.ПрочитатьЦелое32();
	РазмерИсходныхДанных = ЧтениеДанных.ПрочитатьЦелое32();
	
	РазмерИмениФайла = ЧтениеДанных.ПрочитатьЦелое16();
	РазмерДополнительногоПоля = ЧтениеДанных.ПрочитатьЦелое16();
	ЧтениеДанных.Пропустить(РазмерИмениФайла + РазмерДополнительногоПоля);
	
	ПотокGZip = Новый ПотокВПамяти;
	ЗаписьДанных = Новый ЗаписьДанных(ПотокGZip);
	ЧтениеДанных.КопироватьВ(ЗаписьДанных, РазмерСжатыхДанных);
	
	Возврат ПотокGZip.ЗакрытьИПолучитьДвоичныеДанные();
	
КонецФункции

Функция ФорматPlantUML(Данные)
	
	Результат = "";
	СтрокаИскомая = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
	СтрокаПодстановки = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz-_";
	
	Для Счетчик = 0 По СтрДлина(Данные) - 1 Цикл
		ТекСимвол = Сред(Данные, Счетчик + 1, 1);
		Если ТекСимвол = Символы.ПС Или ТекСимвол = Символы.ВК Тогда
			Продолжить;
		КонецЕсли;
		ПозицияСимвола = СтрНайти(СтрокаИскомая, ТекСимвол);
		Если ПозицияСимвола > 0 Тогда
			Результат = Результат + Сред(СтрокаПодстановки, ПозицияСимвола, 1);
		Иначе
			Результат = Результат + ТекСимвол;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ЗаписатьZip(Данные)
	
	#Если МобильноеПриложениеСервер Тогда
		ВызватьИсключение(НСтр("ru = 'Работа с Zip-файлами в мобильной платформе не поддерживается'"));
	#Иначе
		ВременныйФайл = ПолучитьИмяВременногоФайла(".bin");
		Попытка
			Данные.Записать(ВременныйФайл);
			ПотокZip = Новый ПотокВПамяти;
			ЗаписьZip = Новый ЗаписьZipФайла(ПотокZip);
			ЗаписьZip.Добавить(ВременныйФайл);
			ЗаписьZip.Записать();
			УдалитьФайлы(ВременныйФайл);
			Возврат ПотокZip.ЗакрытьИПолучитьДвоичныеДанные();
		Исключение
			Попытка
				УдалитьФайлы(ВременныйФайл);
			Исключение
			КонецПопытки;
			ВызватьИсключение;
		КонецПопытки;
	#КонецЕсли
	
КонецФункции

#КонецОбласти

#КонецОбласти
