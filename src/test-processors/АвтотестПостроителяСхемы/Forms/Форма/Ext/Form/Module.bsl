
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Результаты = Новый Массив;
	ПутьКОбработке = "C:\Users\d.proskurnin\AppData\Local\Temp\PostroitelShemyObmenov.epf";
	
	Попытка
		Сведения = СведенияОбработкиНаСервере(ПутьКОбработке);
		ДобавитьРезультат(Результаты, "metadata.name", "Имя обработки", Сведения.Имя = "PlantUML", Сведения.Имя);
		ДобавитьРезультат(Результаты, "metadata.comment", "Версия из комментария метаданных", СтрНайти(Сведения.Комментарий, "v0.041") > 0, Сведения.Комментарий);
		ДобавитьРезультат(Результаты, "bsp.kind", "Вид дополнительной обработки", Сведения.Вид = "ДополнительнаяОбработка", Сведения.Вид);
		ДобавитьРезультат(Результаты, "bsp.version", "Версия регистрации совпадает с комментарием", Сведения.Версия = Сведения.Комментарий, Сведения.Версия);
		ДобавитьРезультат(Результаты, "bsp.safeMode", "Безопасный режим выключен", Сведения.БезопасныйРежим = Ложь, Строка(Сведения.БезопасныйРежим));
		ДобавитьРезультат(Результаты, "bsp.commands", "Есть команда открытия формы", Сведения.КоличествоКоманд > 0, Строка(Сведения.КоличествоКоманд));
	Исключение
		ДобавитьРезультат(Результаты, "connect", "Подключение внешней обработки на сервере", Ложь, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	СохранитьОтчетНаСервере(Результаты);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ПрогнатьАвтотест();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПрогнатьАвтотест()
	
	Результаты = Новый Массив;
	ПутьКОбработке = ПутьКТестируемойОбработке();
	
	Попытка
		Сведения = СведенияОбработкиНаСервере(ПутьКОбработке);
		ДобавитьРезультат(Результаты, "metadata.name", "Имя обработки", Сведения.Имя = "PlantUML", Сведения.Имя);
		ДобавитьРезультат(Результаты, "metadata.comment", "Версия из комментария метаданных", СтрНайти(Сведения.Комментарий, "v0.041") > 0, Сведения.Комментарий);
		ДобавитьРезультат(Результаты, "bsp.kind", "Вид дополнительной обработки", Сведения.Вид = "ДополнительнаяОбработка", Сведения.Вид);
		ДобавитьРезультат(Результаты, "bsp.version", "Версия регистрации совпадает с комментарием", Сведения.Версия = Сведения.Комментарий, Сведения.Версия);
		ДобавитьРезультат(Результаты, "bsp.safeMode", "Безопасный режим выключен", Сведения.БезопасныйРежим = Ложь, Строка(Сведения.БезопасныйРежим));
		ДобавитьРезультат(Результаты, "bsp.commands", "Есть команда открытия формы", Сведения.КоличествоКоманд > 0, Строка(Сведения.КоличествоКоманд));
	Исключение
		ДобавитьРезультат(Результаты, "connect", "Подключение внешней обработки", Ложь, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		СохранитьОтчетНаСервере(Результаты);
		ЗавершитьРаботуСистемы(Ложь);
		Возврат;
	КонецПопытки;
	
	Попытка
		ИмяОбработки = ПодключитьОбработкуНаСервере(ПутьКОбработке);
		Форма = ПолучитьФорму("ВнешняяОбработка." + ИмяОбработки + ".Форма.Форма");
		ДобавитьРезультат(Результаты, "form.open", "Форма обработки получена", Форма <> Неопределено, ИмяОбработки);
	Исключение
		ДобавитьРезультат(Результаты, "form.open", "Форма обработки получена", Ложь, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		СохранитьОтчетНаСервере(Результаты);
		ЗавершитьРаботуСистемы(Ложь);
		Возврат;
	КонецПопытки;
	
	Попытка
		Форма.ЗаголовокСхемы = "Автотест схемы обменов";
		СтрокаУТ = Форма.Объект.Базы.Добавить();
		СтрокаУТ.База = "УТ";
		СтрокаУТ.Комментарий = "Торговля";
		СтрокаБУ = Форма.Объект.Базы.Добавить();
		СтрокаБУ.База = "БУ";
		СтрокаОбмен = Форма.Объект.Обмены.Добавить();
		СтрокаОбмен.БазаИсточник = "УТ";
		СтрокаОбмен.БазаПриемник = "БУ";
		СтрокаОбмен.Наименование = "ОбменУТБУ";
		СтрокаОбмен.Двусторонний = Истина;
		Форма.СформироватьСхемуНаКлиенте();
		ТекстСхемы = Строка(Форма.Схема);
		ДобавитьРезультат(Результаты, "schema.start", "Схема начинается с @startuml", СтрНачинаетсяС(СокрЛ(ТекстСхемы), "@startuml"), Лев(ТекстСхемы, 40));
		ДобавитьРезультат(Результаты, "schema.bases", "В схеме есть обе базы", СтрНайти(ТекстСхемы, "УТ") > 0 И СтрНайти(ТекстСхемы, "БУ") > 0, "");
		ДобавитьРезультат(Результаты, "schema.arrow", "В схеме есть стрелка обмена", СтрНайти(ТекстСхемы, "ОбменУТБУ") > 0, "");
		ДобавитьРезультат(Результаты, "schema.title", "В схеме есть заголовок", СтрНайти(ТекстСхемы, "Автотест схемы обменов") > 0, "");
		ДобавитьРезультат(Результаты, "schema.image", "Получена картинка PlantUML", ЗначениеЗаполнено(Форма.РезультатОбработки), Строка(Форма.РезультатОбработки));
	Исключение
		ДобавитьРезультат(Результаты, "schema.generate", "Формирование схемы PlantUML", Ложь, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		СохранитьОтчетНаСервере(Результаты);
		ЗавершитьРаботуСистемы(Ложь);
		Возврат;
	КонецПопытки;
	
	Попытка
		АдресФайла = Форма.ПоместитьНастройкиXMLВоВременноеХранилище();
		ДобавитьРезультат(Результаты, "xml.save", "Настройки выгружены во временное хранилище", ЗначениеЗаполнено(АдресФайла), "");
		Форма.Объект.Базы.Очистить();
		Форма.Объект.Обмены.Очистить();
		Форма.ЗаголовокСхемы = "";
		Форма.ПрочитатьНастройкиИзXMLНаСервере(АдресФайла);
		ДобавитьРезультат(Результаты, "xml.load.bases", "После загрузки XML восстановлены базы", Форма.Объект.Базы.Количество() = 2, Строка(Форма.Объект.Базы.Количество()));
		ДобавитьРезультат(Результаты, "xml.load.exchanges", "После загрузки XML восстановлены обмены", Форма.Объект.Обмены.Количество() = 1, Строка(Форма.Объект.Обмены.Количество()));
		ДобавитьРезультат(Результаты, "xml.load.title", "После загрузки XML восстановлен заголовок", Форма.ЗаголовокСхемы = "Автотест схемы обменов", Форма.ЗаголовокСхемы);
	Исключение
		ДобавитьРезультат(Результаты, "xml.roundtrip", "Круговой тест XML настроек", Ложь, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	СохранитьОтчетНаСервере(Результаты);
	ЗавершитьРаботуСистемы(Ложь);
	
КонецПроцедуры

&НаКлиенте
Функция ПутьКТестируемойОбработке()
	
	Если ЗначениеЗаполнено(ПараметрЗапуска) Тогда
		Возврат СокрЛП(ПараметрЗапуска);
	КонецЕсли;
	
	Возврат "C:\Users\d.proskurnin\AppData\Local\Temp\PostroitelShemyObmenov.epf";
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьРезультат(Результаты, Идентификатор, Наименование, Успех, Подробности)
	
	СтрокаРезультата = Новый Структура;
	СтрокаРезультата.Вставить("id", Идентификатор);
	СтрокаРезультата.Вставить("name", Наименование);
	СтрокаРезультата.Вставить("passed", Успех);
	СтрокаРезультата.Вставить("detail", Строка(Подробности));
	Результаты.Добавить(СтрокаРезультата);
	
КонецПроцедуры

&НаСервере
Функция СведенияОбработкиНаСервере(ПутьКОбработке)
	
	Обработка = ВнешниеОбработки.Создать(ПутьКОбработке, Ложь);
	МетаданныеОбработки = Обработка.Метаданные();
	Сведения = Обработка.СведенияОВнешнейОбработке();
	
	Результат = Новый Структура;
	Результат.Вставить("Имя", МетаданныеОбработки.Имя);
	Результат.Вставить("Комментарий", МетаданныеОбработки.Комментарий);
	Результат.Вставить("Вид", Сведения.Вид);
	Результат.Вставить("Версия", Сведения.Версия);
	Результат.Вставить("БезопасныйРежим", Сведения.БезопасныйРежим);
	Результат.Вставить("Наименование", Сведения.Наименование);
	Результат.Вставить("КоличествоКоманд", Сведения.Команды.Количество());
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПодключитьОбработкуНаСервере(ПутьКОбработке)
	
	Возврат ВнешниеОбработки.Подключить(ПутьКОбработке, , Ложь);
	
КонецФункции

&НаСервере
Процедура СохранитьОтчетНаСервере(Результаты)
	
	Отчет = Новый Структура;
	Отчет.Вставить("infobase", "C:\Users\d.proskurnin\Documents\InfoBase8");
	Отчет.Вставить("finishedAt", Формат(ТекущаяДатаСеанса(), "ДФ=yyyy-MM-ddTHH:mm:ss"));
	Отчет.Вставить("tests", Результаты);
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.ОткрытьФайл("C:\Users\d.proskurnin\AppData\Local\Temp\1cObmSchem-test-report.json");
	ЗаписатьJSON(ЗаписьJSON, Отчет);
	ЗаписьJSON.Закрыть();
	
КонецПроцедуры

#КонецОбласти
